                {
                  "type": "null"
                }
              ]
            },
            "data_entrega": {
              "description": "AAAA-MM-DD; null remove.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hora_entrega": {
              "description": "HH:MM; null remove.",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}(:\\d{2})?$"
                },
