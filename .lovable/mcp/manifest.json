      {
        "name": "mapa_do_sistema",
        "title": "Mapa do sistema",
        "description": "Explica os módulos e o vocabulário do Marketing Juff e traz contagens e quadros que você pode ver.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
